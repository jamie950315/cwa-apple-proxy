# /etc/systemd/system/cwa-weather-route-status.service
[Unit]
Description=CWA Weather selective-route approval status
After=tailscaled.service
[Service]
Type=oneshot
User=jamie
WorkingDirectory=/home/jamie/cwa-weather-proxy
ExecStart=/home/jamie/cwa-weather-proxy/.venv/bin/python /home/jamie/cwa-weather-proxy/split_routes.py status --write-status
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/home/jamie/cwa-weather-proxy/data
TimeoutStartSec=65
