# /etc/systemd/system/cwa-weather-proxy.service
[Unit]
Description=CWA Apple Weather reverse proxy
After=network-online.target cwa-weather-api.service cwa-weather-codec.service
Wants=network-online.target
[Service]
User=jamie
Group=jamie
WorkingDirectory=/home/jamie/cwa-weather-proxy
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/jamie/cwa-weather-proxy/.venv/bin/mitmdump --mode reverse:https://weatherkit.apple.com --listen-host 127.0.0.1 --listen-port 18443 --set keep_host_header=true --set confdir=/home/jamie/cwa-weather-proxy/certs/mitm --certs weatherkit.apple.com=/home/jamie/cwa-weather-proxy/certs/weatherkit.pem --set flow_detail=0 --set termlog_verbosity=warn -s /home/jamie/cwa-weather-proxy/addon.py
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
UMask=0077
[Install]
WantedBy=multi-user.target
