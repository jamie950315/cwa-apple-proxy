[Unit]
Description=CWA Weather normalized data API
After=network-online.target tailscaled.service
Wants=network-online.target
[Service]
User=jamie
Group=jamie
WorkingDirectory=/home/jamie/cwa-weather-proxy
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/jamie/cwa-weather-proxy/.venv/bin/uvicorn api:app --host 100.78.140.101 --port 18880 --no-access-log
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
UMask=0077
[Install]
WantedBy=multi-user.target
